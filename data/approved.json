[
  {
    "id": "folk-001",
    "text": "Kdo se ptá, ten se dozví.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-002",
    "text": "Žádný učený z nebe nespadl.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-003",
    "text": "Opakování je matka moudrosti.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-004",
    "text": "Ranní ptáče dál doskáče.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-005",
    "text": "Dvakrát měř, jednou řež.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-006",
    "text": "Bez práce nejsou koláče.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-007",
    "text": "Trpělivost růže přináší.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-008",
    "text": "V nouzi poznáš přítele.",
    "language": "cs",
    "topic": "Přátelství",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-009",
    "text": "Ve dvou se to lépe táhne.",
    "language": "cs",
    "topic": "Přátelství",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-010",
    "text": "Kdo jinému jámu kopá, sám do ní padá.",
    "language": "cs",
    "topic": "Přísloví",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-011",
    "text": "Co můžeš udělat dnes, neodkládej na zítřek.",
    "language": "cs",
    "topic": "Přísloví",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-012",
    "text": "Lepší vrabec v hrsti než holub na střeše.",
    "language": "cs",
    "topic": "Přísloví",
    "author": "Lidové přísloví",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-013",
    "text": "Opakovanie je matka múdrosti.",
    "language": "sk",
    "topic": "Vzdelanie",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-014",
    "text": "Nikto učený z neba nespadol.",
    "language": "sk",
    "topic": "Vzdelanie",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-015",
    "text": "Kto sa pýta, ten sa dozvie.",
    "language": "sk",
    "topic": "Vzdelanie",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-016",
    "text": "Ranné vtáča ďalej doskáče.",
    "language": "sk",
    "topic": "Múdrosť",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-017",
    "text": "Dvakrát meraj, raz rež.",
    "language": "sk",
    "topic": "Múdrosť",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-018",
    "text": "Bez práce nie sú koláče.",
    "language": "sk",
    "topic": "Múdrosť",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-019",
    "text": "Trpezlivosť ruže prináša.",
    "language": "sk",
    "topic": "Múdrosť",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-020",
    "text": "V núdzi poznáš priateľa.",
    "language": "sk",
    "topic": "Priateľstvo",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-021",
    "text": "Vo dvojici sa to lepšie ťahá.",
    "language": "sk",
    "topic": "Priateľstvo",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-022",
    "text": "Kto druhému jamu kope, sám do nej spadne.",
    "language": "sk",
    "topic": "Príslovia",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-023",
    "text": "Čo môžeš urobiť dnes, neodkladaj na zajtra.",
    "language": "sk",
    "topic": "Príslovia",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "folk-024",
    "text": "Lepší vrabec v hrsti ako holub na streche.",
    "language": "sk",
    "topic": "Príslovia",
    "author": "Ľudové príslovie",
    "source": "Tradiční lidová slovesnost",
    "rights": "PD-traditional"
  },
  {
    "id": "person-001",
    "text": "Čemukoli vyučuješ, hleď aby jasná pravda byla.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-002",
    "text": "Dobré knihy jsou vpravdě brusem rozumu, pilníkem soudnosti, balšámem očí.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-003",
    "text": "Dobrý učitel, dobrý učeň, dobré učení mocně umění rozmnožuje.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-004",
    "text": "I při nejlepším předsevzetí chybiti se může.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-005",
    "text": "Jediná lakota jest počestná – lakota času.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-006",
    "text": "Nevěřte všemu, co se vám k věření předkládá.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-007",
    "text": "Poznání sebe sama je základem pravé moudrosti.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-008",
    "text": "Šťastný je člověk, kterého varuje cizí chyba.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-009",
    "text": "Učení samo má býti milé a libé a nemá se jinak díti, než jako hra a kratochvíle.",
    "language": "cs",
    "topic": "Vzdělání",
    "author": "Jan Amos Komenský",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Jan_Amos_Komensk%C3%BD",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-010",
    "text": "Skutečně velké osobnosti se ve všem projevují přirozeně.",
    "language": "cs",
    "topic": "Osobnosti",
    "author": "Josef Čapek",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Josef_%C4%8Capek",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-011",
    "text": "Umění je krásná pravda, naprosto ne krásná lež.",
    "language": "cs",
    "topic": "Osobnosti",
    "author": "Josef Čapek",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Josef_%C4%8Capek",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-012",
    "text": "Jediným skutečným bohatstvím člověka je jeho osobnost, která vede jeho činy i myšlenky.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Josef Čapek",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Josef_%C4%8Capek",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-013",
    "text": "Náhoda pomáhá těm, kteří jsou na ni připraveni.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Blaise Pascal",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Blaise_Pascal",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "person-014",
    "text": "Jsou na světě hodnoty, které nemilujeme, dokud je nechápeme, a jiné, které nechápeme, dokud je nemilujeme.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Blaise Pascal",
    "source": "Wikicitáty – uvedeno s bibliografickým odkazem nebo v oddílu výroků",
    "source_url": "https://cs.wikiquote.org/wiki/Blaise_Pascal",
    "rights": "PD-author-original; translation-status-unverified",
    "audience": "all",
    "verification": "secondary-source"
  },
  {
    "id": "vymazal-3",
    "text": "Nejlepší vynálezy se rozumějí samy sebou.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 3",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-25",
    "text": "První krok moudrosti je na všechno naříkat; druhý krok je se vším se smířit.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 25",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-121",
    "text": "Každá opravdová práce vzdělává. Pouze biflování je zabíjení času.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 121",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-128",
    "text": "Všecka věda je vědění dnešního dne.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 128",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-146",
    "text": "Nesmysl se u nás provede snadno, rozumná věc těžko.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 146",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-506",
    "text": "Mladí vědí všecko lépe, jenom že to neumějí udělat.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 506",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-679",
    "text": "Po skutečně velkých lidech zbude věc, po zdánlivě velkých holé jméno.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 679",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-848",
    "text": "Za hranicemi našeho mikroskopu leží ještě celé světy, jež toliko můžeme tušiti.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 848",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-860",
    "text": "Dlouho žije, kdo mnoho myslí.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 860",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "vymazal-875",
    "text": "Jak dobře se často obejdeme bez toho, čeho jsme nedostali.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Autor neznámý",
    "source": "Tisíc nových zrnek (1911), č. 875",
    "source_url": "https://cs.wikisource.org/wiki/Tis%C3%ADc_nov%C3%BDch_zrnek",
    "rights": "PD-old-70",
    "audience": "all",
    "collector": "František Vymazal"
  },
  {
    "id": "capek-k-1",
    "text": "Člověk se víc stydí za svou pitomost než za své hříchy.",
    "language": "cs",
    "topic": "Moudrost",
    "author": "Karel Čapek",
    "source": "Rovnost, 5. 10. 1990 (sekundární doklad)",
    "source_url": "https://cs.wikiquote.org/wiki/Karel_%C4%8Capek",
    "rights": "PD-old-70",
    "audience": "all",
    "verification": "secondary-citation; primary source pending"
  },
  {
    "id": "capek-k-2",
    "text": "Hlavně se chovat tak, abys nikdy neztratil úctu sám před sebou.",
    "language": "cs",
    "topic": "Odvaha",
    "author": "Karel Čapek",
    "source": "Zdeněk Vaněk: Kaleidoskop (2009), s. dle Wikicitátů",
    "source_url": "https://cs.wikiquote.org/wiki/Karel_%C4%8Capek",
    "rights": "PD-old-70",
    "audience": "all",
    "verification": "secondary-citation; primary source pending"
  },
  {
    "id": "capek-k-3",
    "text": "Humor je nejdemokratičtější z lidských zvyků.",
    "language": "cs",
    "topic": "Humor",
    "author": "Karel Čapek",
    "source": "Wikicitáty, odkaz na bibliografický pramen č. 4",
    "source_url": "https://cs.wikiquote.org/wiki/Karel_%C4%8Capek",
    "rights": "PD-old-70",
    "audience": "all",
    "verification": "secondary-citation; primary source pending"
  }
]
